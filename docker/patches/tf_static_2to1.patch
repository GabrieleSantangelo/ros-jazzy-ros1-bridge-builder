+// /tf_static is bridged from several independent ROS 2 publishers (one per
+// static broadcaster). The generic 2to1 bridge forwards each incoming
+// message through a single latched ROS 1 publisher, so each publish()
+// overwrites the previous one in the latch cache and late ROS 1 subscribers
+// only ever see whichever source published last. This aggregates every
+// transform ever seen, keyed by child_frame_id, and republishes the full
+// merged set on every update so the latch always holds the complete tree.
+class TFStaticAggregator
+{
+public:
+  TFStaticAggregator(rclcpp::Node::SharedPtr ros2_node, ros::Publisher ros1_pub)
+  : ros1_pub_(ros1_pub)
+  {
+    auto qos = rclcpp::QoS(rclcpp::KeepLast(100));
+    qos.keep_all();
+    qos.transient_local();
+    qos.reliable();
+    sub_ = ros2_node->create_subscription<tf2_msgs::msg::TFMessage>(
+      "/tf_static", qos,
+      [this](tf2_msgs::msg::TFMessage::SharedPtr msg) {
+        for (const auto & t : msg->transforms) {
+          transforms_[t.child_frame_id] = t;
+        }
+        tf2_msgs::msg::TFMessage merged;
+        for (const auto & kv : transforms_) {
+          merged.transforms.push_back(kv.second);
+        }
+        tf2_msgs::TFMessage ros1_msg;
+        ros1_bridge::Factory<tf2_msgs::TFMessage, tf2_msgs::msg::TFMessage>::convert_2_to_1(
+          merged, ros1_msg);
+        ros1_pub_.publish(ros1_msg);
+      });
+  }
+
+private:
+  std::map<std::string, geometry_msgs::msg::TransformStamped> transforms_;
+  rclcpp::Subscription<tf2_msgs::msg::TFMessage>::SharedPtr sub_;
+  ros::Publisher ros1_pub_;
+};
